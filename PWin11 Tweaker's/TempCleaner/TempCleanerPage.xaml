<Page
    x:Class="PWin11_Tweaker_s.TempCleaner.TempCleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PWin11_Tweaker_s.TempCleaner"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="CheckBoxStackPanelStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SizeTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="PreviewListItemStyle" TargetType="ListViewItem">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style x:Key="IconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock 
            x:Name="UpdateWarningText"
            Grid.Row="0"
            x:Uid="UpdateWarning" 
            Foreground="Orange"
            FontSize="14"
            TextWrapping="Wrap"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            Margin="0,10,0,20"/>

        <TextBlock 
            Grid.Row="1"
            x:Uid="TempPageTitle"
            FontSize="24"
            FontWeight="Bold"
            Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
            <StackPanel>
                <StackPanel Style="{StaticResource CheckBoxStackPanelStyle}">
                    <CheckBox 
                        x:Name="TempFilesCheckBox" 
                        x:Uid="TempCheckBoxTEMP" 
                        IsChecked="True" 
                        Checked="CheckBox_Changed" 
                        Unchecked="CheckBox_Changed"/>
                    <TextBlock 
                        x:Name="TempFilesSizeText" 
                        Style="{StaticResource SizeTextBlockStyle}" 
                        Text="Error"/>
                </StackPanel>

                <StackPanel Style="{StaticResource CheckBoxStackPanelStyle}">
                    <CheckBox 
                        x:Name="RecycleBinCheckBox" 
                        x:Uid="TempPageCheckBoxTrash" 
                        IsChecked="True" 
                        Checked="CheckBox_Changed" 
                        Unchecked="CheckBox_Changed"/>
                    <TextBlock 
                        x:Name="RecycleBinSizeText" 
                        Style="{StaticResource SizeTextBlockStyle}" 
                        Text="0 MB"/>
                </StackPanel>

                <StackPanel Style="{StaticResource CheckBoxStackPanelStyle}">
                    <CheckBox 
                        x:Name="BrowserCacheCheckBox" 
                        x:Uid="TempPageCacheBrowserCheckBox" 
                        IsChecked="True" 
                        Checked="CheckBox_Changed" 
                        Unchecked="CheckBox_Changed"/>
                    <TextBlock 
                        x:Name="BrowserCacheSizeText" 
                        Style="{StaticResource SizeTextBlockStyle}" 
                        Text="0 MB"/>
                </StackPanel>

                <StackPanel Style="{StaticResource CheckBoxStackPanelStyle}">
                    <CheckBox 
                        x:Name="WindowsUpdateCacheCheckBox" 
                        x:Uid="TempPageWindowsUpdateCacheCheckBox" 
                        IsChecked="False" 
                        Checked="CheckBox_Changed" 
                        Unchecked="CheckBox_Changed"/>
                    <TextBlock 
                        x:Name="WindowsUpdateCacheSizeText" 
                        Style="{StaticResource SizeTextBlockStyle}" 
                        Text="0 MB"/>
                </StackPanel>

                <StackPanel Style="{StaticResource CheckBoxStackPanelStyle}">
                    <CheckBox 
                        x:Name="ThumbnailsCheckBox" 
                        x:Uid="TempPageThumbnailsCheckBox" 
                        IsChecked="False" 
                        Checked="CheckBox_Changed" 
                        Unchecked="CheckBox_Changed"/>
                    <TextBlock 
                        x:Name="ThumbnailsSizeText" 
                        Style="{StaticResource SizeTextBlockStyle}" 
                        Text="0 MB"/>
                </StackPanel>

                <StackPanel Style="{StaticResource CheckBoxStackPanelStyle}">
                    <CheckBox 
                        x:Name="DeliveryOptCheckBox" 
                        x:Uid="TempPageDeliveryOptCheckBox" 
                        IsChecked="False" 
                        Checked="CheckBox_Changed" 
                        Unchecked="CheckBox_Changed"/>
                    <TextBlock 
                        x:Name="DeliveryOptSizeText" 
                        Style="{StaticResource SizeTextBlockStyle}" 
                        Text="0 MB"/>
                </StackPanel>

                <StackPanel Style="{StaticResource CheckBoxStackPanelStyle}">
                    <CheckBox 
                        x:Name="SystemLogsCheckBox" 
                        x:Uid="TempPageSystemLogsCheckBox" 
                        IsChecked="False" 
                        Checked="CheckBox_Changed" 
                        Unchecked="CheckBox_Changed"/>
                    <TextBlock 
                        x:Name="SystemLogsSizeText" 
                        Style="{StaticResource SizeTextBlockStyle}" 
                        Text="0 MB"/>
                </StackPanel>

                <StackPanel Style="{StaticResource CheckBoxStackPanelStyle}">
                    <CheckBox 
                        x:Name="OldWinFilesCheckBox" 
                        x:Uid="TempPageOldWinFilesCheckBox" 
                        IsChecked="False" 
                        Checked="CheckBox_Changed" 
                        Unchecked="CheckBox_Changed"/>
                    <TextBlock 
                        x:Name="OldWinFilesSizeText" 
                        Style="{StaticResource SizeTextBlockStyle}" 
                        Text="0 MB"/>
                </StackPanel>

                <StackPanel Style="{StaticResource CheckBoxStackPanelStyle}">
                    <CheckBox 
                        x:Name="AppCacheCheckBox" 
                        x:Uid="TempPageAppCacheCheckBox" 
                        IsChecked="False" 
                        Checked="CheckBox_Changed" 
                        Unchecked="CheckBox_Changed"/>
                    <TextBlock 
                        x:Name="AppCacheSizeText" 
                        Style="{StaticResource SizeTextBlockStyle}" 
                        Text="0 MB"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Vertical" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Button 
                    x:Name="CleanButton" 
                    x:Uid="CleanButton" 
                    Click="CleanButton_Click" 
                    Margin="0,0,10,0"/>
                <TextBlock 
                    x:Name="TotalSizeText" 
                    x:Uid="TotalSizeText" 
                    Margin="10,0,10,0" 
                    VerticalAlignment="Center"
                    FontSize="14"/>
                <ProgressBar 
                    x:Name="ProgressBar" 
                    Width="200" 
                    IsIndeterminate="True" 
                    Visibility="Collapsed" 
                    Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock 
                x:Name="StatisticsText" 
                x:Uid="StatisticsText" 
                FontSize="12" 
                Margin="0,10,0,0" 
                TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button 
                    x:Name="PreviewButton" 
                    x:Uid="PreviewButton" 
                    Click="PreviewButton_Click"/>
                <TextBlock 
                    x:Name="ToggleIcon" 
                    Style="{StaticResource IconStyle}" 
                    Text="" 
                    Visibility="Collapsed"/>
            </StackPanel>
            <ScrollViewer 
                VerticalScrollBarVisibility="Auto" 
                Margin="0,10,0,0">
                <ListView 
                    x:Name="PreviewListView" 
                    Visibility="Collapsed" 
                    MaxHeight="150" 
                    SelectionMode="None"
                    ItemContainerStyle="{StaticResource PreviewListItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Path=Name}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Path=Size}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>
            <TextBlock 
                x:Name="StatusText" 
                x:Uid="StatusText" 
                FontSize="14" 
                Foreground="Green" 
                Margin="0,20,0,0" 
                HorizontalAlignment="Left"/>
            <Button 
                x:Name="FeedbackButton" 
                x:Uid="FeedbackButton" 
                Click="FeedbackButton_Click" 
                Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Page>