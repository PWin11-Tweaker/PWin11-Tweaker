<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PWin11_Tweaker_s.TempCleaner.TempCleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PWin11_Tweaker_s.TempCleaner"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <!-- Стили для единообразного вида -->
        <Style x:Key="CheckBoxStackPanelStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SizeTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Page.Resources>

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock 
            Grid.Row="0"
            x:Uid="TempPageTitle"
            FontSize="24"
            FontWeight="Bold"
            Margin="0,0,0,20"
            Text="Очистка временных файлов"/>

        <!-- Список категорий для очистки -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <!-- Временные файлы -->
            <StackPanel Style="{StaticResource CheckBoxStackPanelStyle}">
                <CheckBox 
                    x:Name="TempFilesCheckBox" 
                    x:Uid="TempCheckBoxTEMP" 
                    IsChecked="True" 
                    Checked="CheckBox_Changed" 
                    Unchecked="CheckBox_Changed"
                    Content="Временные файлы (%TEMP%)"/>
                <TextBlock 
                    x:Name="TempFilesSizeText" 
                    Style="{StaticResource SizeTextBlockStyle}" 
                    Text="Error"/>
            </StackPanel>

            <!-- Корзина -->
            <StackPanel Style="{StaticResource CheckBoxStackPanelStyle}">
                <CheckBox 
                    x:Name="RecycleBinCheckBox" 
                    x:Uid="TempPageCheckBoxTrash" 
                    IsChecked="True" 
                    Checked="CheckBox_Changed" 
                    Unchecked="CheckBox_Changed"
                    Content="Корзина"/>
                <TextBlock 
                    x:Name="RecycleBinSizeText" 
                    Style="{StaticResource SizeTextBlockStyle}" 
                    Text="0 MB"/>
            </StackPanel>

            <!-- Кэш браузеров -->
            <StackPanel Style="{StaticResource CheckBoxStackPanelStyle}">
                <CheckBox 
                    x:Name="BrowserCacheCheckBox" 
                    x:Uid="TempPageCacheBrowserCheckBox" 
                    IsChecked="True" 
                    Checked="CheckBox_Changed" 
                    Unchecked="CheckBox_Changed"
                    Content="Кэш браузеров"/>
                <TextBlock 
                    x:Name="BrowserCacheSizeText" 
                    Style="{StaticResource SizeTextBlockStyle}" 
                    Text="0 MB"/>
            </StackPanel>

            <!-- Кэш обновлений Windows -->
            <StackPanel Style="{StaticResource CheckBoxStackPanelStyle}">
                <CheckBox 
                    x:Name="WindowsUpdateCacheCheckBox" 
                    x:Uid="TempPageWindowsUpdateCacheCheckBox" 
                    IsChecked="False" 
                    Checked="CheckBox_Changed" 
                    Unchecked="CheckBox_Changed"
                    Content="Кэш обновлений Windows"/>
                <TextBlock 
                    x:Name="WindowsUpdateCacheSizeText" 
                    Style="{StaticResource SizeTextBlockStyle}" 
                    Text="0 MB"/>
            </StackPanel>

            <!-- Эскизы -->
            <StackPanel Style="{StaticResource CheckBoxStackPanelStyle}">
                <CheckBox 
                    x:Name="ThumbnailsCheckBox" 
                    x:Uid="TempPageThumbnailsCheckBox" 
                    IsChecked="False" 
                    Checked="CheckBox_Changed" 
                    Unchecked="CheckBox_Changed"
                    Content="Эскизы"/>
                <TextBlock 
                    x:Name="ThumbnailsSizeText" 
                    Style="{StaticResource SizeTextBlockStyle}" 
                    Text="0 MB"/>
            </StackPanel>
        </StackPanel>

        <!-- Кнопка очистки, итоговый размер и статус -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button 
                x:Name="CleanButton" 
                x:Uid="CleanButton" 
                Click="CleanButton_Click" 
                Margin="0,0,10,0"
                Content="Очистить"/>
            <TextBlock 
                x:Name="TotalSizeText" 
                Text="Всего: 0 MB" 
                Margin="10,0,10,0" 
                VerticalAlignment="Center"
                FontSize="14"/>
            <ProgressBar 
                x:Name="ProgressBar" 
                Width="200" 
                IsIndeterminate="True" 
                Visibility="Collapsed" 
                Margin="10,0,0,0"/>
        </StackPanel>
        <TextBlock 
            x:Name="StatusText" 
            Grid.Row="2" 
            Text="" 
            FontSize="14" 
            Foreground="Green" 
            Margin="0,40,0,0" 
            HorizontalAlignment="Left"/>
    </Grid>
</Page>