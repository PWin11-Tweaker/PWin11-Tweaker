<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PWin11_Tweaker_s.TempCleaner.TempCleanerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PWin11_Tweaker_s.TempCleaner"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock 
            Grid.Row="0"
            Text="Очистка временных файлов"
            FontSize="24"
            FontWeight="Bold"
            Margin="0,0,0,20"/>

        <!-- Список категорий для очистки -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox x:Name="TempFilesCheckBox" Content="Временные файлы (%TEMP%)" IsChecked="True" Checked="CheckBox_Changed" Unchecked="CheckBox_Changed"/>
                <TextBlock x:Name="TempFilesSizeText" Text="0 MB" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox x:Name="RecycleBinCheckBox" Content="Корзина" IsChecked="True" Checked="CheckBox_Changed" Unchecked="CheckBox_Changed"/>
                <TextBlock x:Name="RecycleBinSizeText" Text="0 MB" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox x:Name="BrowserCacheCheckBox" Content="Кэш браузеров" IsChecked="True" Checked="CheckBox_Changed" Unchecked="CheckBox_Changed"/>
                <TextBlock x:Name="BrowserCacheSizeText" Text="0 MB" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Кнопка очистки и статус -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="CleanButton" Content="Очистить" Click="CleanButton_Click" Margin="0,0,10,0"/>
            <TextBlock x:Name="TotalSizeText" Text="Всего: 0 MB" Margin="10,0,10,0" VerticalAlignment="Center"/>
            <ProgressBar x:Name="ProgressBar" Width="200" IsIndeterminate="True" Visibility="Collapsed" Margin="10,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="2" Text="" FontSize="14" Foreground="Green" Margin="0,40,0,0" HorizontalAlignment="Left"/>
    </Grid>
</Page>