<Window
    x:Class="PWin11_Tweaker_s.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!-- ="PWin11 Tweaker's" -->

    <Grid>
        
        <NavigationView x:ConnectionId='2' x:Name="NavView"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        
                                                         >
            <NavigationView.Resources>
                <!-- Стиль для FontIcon -->
                <Style TargetType="FontIcon">
                    <Setter Property="FontSize" Value="20"/>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimary}"/>
                </Style>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Home" Tag="HomePage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph=""/>
                        <!-- Home -->
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Explorer" Tag="ExplorerPage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph=""/>
                        <!-- Folder -->
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="System" Tag="SystemPage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph=""/>
                        <!-- System -->
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Interface" Tag="InterfacePage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph=""/>
                        <!-- Layout -->
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Performance" Tag="PerformancePage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph=""/>
                        <!-- Speedometer -->
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Privacy" Tag="PrivacyPage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph=""/>
                        <!-- Permissions -->
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator/>
            </NavigationView.MenuItems>
            <Frame x:ConnectionId='4' x:Name="ContentFrame" Margin="20" />
        </NavigationView>

        <!-- Надпись о правах администратора -->
        <TextBlock x:ConnectionId='3' x:Name="AdminWarningText" 
                   x:Uid="AdminWarning" 
                   Foreground="Red" 
                   FontSize="14" 
                   TextWrapping="Wrap" 
                   Visibility="Collapsed" 
                   VerticalAlignment="Bottom" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,10"/>
    </Grid>
</Window>

