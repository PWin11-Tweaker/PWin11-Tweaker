<Page
    x:Class="PWin11_Tweaker_s.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PWin11_Tweaker_s"
    xmlns:l="using:WinUI3Localizer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <StackPanel Margin="20" Spacing="10">
        <TextBlock l:Uids.Uid="Performance_Settings" FontSize="24" FontWeight="SemiBold"/>

        <!-- Отключение визуальных эффектов -->
        <CheckBox x:Name="DisableVisualEffectsToggle" l:Uids.Uid="DisableVisualEffects"/>

        <!-- Отключение Windows Search -->
        <CheckBox x:Name="DisableWindowsSearchToggle" l:Uids.Uid="DisableWindowsSearch"/>

        <!-- Отключение SysMain -->
        <CheckBox x:Name="DisableSysMainToggle" l:Uids.Uid="DisableSysMain"/>

        <!-- Отключение индексации поиска -->
        <CheckBox x:Name="DisableSearchIndexingToggle" l:Uids.Uid="DisableSearchIndexing"/>

        <!-- План электропитания -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock l:Uids.Uid="Power_Plan" VerticalAlignment="Center"/>
            <ComboBox x:Name="PowerPlanCombo" SelectionChanged="PowerPlanCombo_SelectionChanged">
                <ComboBoxItem l:Uids.Uid="MaxPerf" Tag="HighPerformance"/>
                <ComboBoxItem l:Uids.Uid="Balanced" Tag="Balanced"/>
                <ComboBoxItem l:Uids.Uid="EnergySaving" Tag="PowerSaver"/>
            </ComboBox>
        </StackPanel>

        <!-- Кнопка для Process Monitor -->
        <Button x:Name="ProcessMonitorButton" Click="ProcessMonitorButton_Click" Margin="0,10,0,0" Content="Проверить"/>

        <!-- Кнопки применения и отмены -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="ApplyButton" l:Uids.Uid="Apply" Click="ApplyButton_Click" Margin="0,10,0,0"/>
            <Button x:Name="CancelButton" Content="Отменить" Click="CancelButton_Click" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Прогресс и статус -->
        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Spacing="5">
            <TextBlock x:Name="StatusText" l:Uids.Uid="Status"/>
            <ProgressBar x:Name="ProgressBar" IsIndeterminate="False" Minimum="0" Maximum="100" Value="0"/>
        </StackPanel>
    </StackPanel>
</Page>