<Page
    x:Class="PWin11_Tweaker_s.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PWin11_Tweaker_s"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <StackPanel Margin="20" Spacing="10">
        <TextBlock x:Uid="Performance_Settings" FontSize="24" FontWeight="SemiBold"/>

        <!-- Отключение визуальных эффектов -->
        <CheckBox x:Name="DisableVisualEffectsToggle" x:Uid="DisableVisualEffects"/>

        <!-- Отключение Windows Search -->
        <CheckBox x:Name="DisableWindowsSearchToggle" x:Uid="DisableWindowsSearch"/>

        <!-- Отключение SysMain -->
        <CheckBox x:Name="DisableSysMainToggle" x:Uid="DisableSysMain"/>

        <!-- Отключение индексации поиска -->
        <CheckBox x:Name="DisableSearchIndexingToggle" x:Uid="DisableSearchIndexing"/>

        <!-- План электропитания -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock x:Uid="Power_Plan" VerticalAlignment="Center"/>
            <ComboBox x:Name="PowerPlanCombo" SelectionChanged="PowerPlanCombo_SelectionChanged">
                <ComboBoxItem x:Uid="MaxPerf" Tag="HighPerformance"/>
                <ComboBoxItem x:Uid="Balanced" Tag="Balanced"/>
                <ComboBoxItem x:Uid="EnergySaving" Tag="PowerSaver"/>
            </ComboBox>
        </StackPanel>

        <!-- Кнопка для Process Monitor -->
        <Button x:Name="ProcessMonitorButton" Click="ProcessMonitorButton_Click" Margin="0,10,0,0" Content="Проверить"/>

        <!-- Кнопка применения -->
        <Button x:Name="ApplyButton" x:Uid="Apply" Click="ApplyButton_Click" Margin="0,10,0,0"/>

        <!-- Прогресс и статус -->
        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Spacing="5">
            <TextBlock x:Name="StatusText" x:Uid="Status"/>
            <ProgressBar x:Name="ProgressBar" IsIndeterminate="False" Minimum="0" Maximum="100" Value="0"/>
        </StackPanel>
    </StackPanel>
</Page>