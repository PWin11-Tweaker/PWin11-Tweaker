<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PWin11_Tweaker_s.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PWin11_Tweaker_s"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <!-- Основной контейнер -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="700" Margin="20">
            <!-- Логотип сверху -->
            <Image Source="/Assets/icon5.png" Width="100" Height="100" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <!-- Текст Welcome с анимированным градиентом -->
            <TextBlock x:Uid="Welcome_HomePage"
                       Name="WelcomeText"
                       FontSize="36" 
                       FontWeight="Bold" 
                       TextWrapping="Wrap" 
                       HorizontalAlignment="Center"
                       Opacity="0">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="WelcomeTransform" Y="50"/>
                </TextBlock.RenderTransform>
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="3,0">
                        <GradientStop Color="#2c79a4" Offset="0"/>
                        <GradientStop Color="#b3eaff" Offset="1"/>
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>

            <!-- Текст About -->
            <TextBlock x:Uid="About"
                       Name="AboutText"
                       FontSize="16" 
                       TextWrapping="Wrap" 
                       HorizontalAlignment="Center" 
                       Margin="0,20,0,30" 
                       Foreground="{ThemeResource TextFillColorSecondary}"
                       Opacity="0">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="AboutTransform" Y="50"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <!-- Кнопки в ряд внизу -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15">
                <Button x:Uid="PrivacyButton_HomePage"
                        Click="GoToPrivacyButton_Click"
                        Style="{StaticResource AccentButtonStyle}"/>
                <Button x:Uid="PerformanceButton_HomePage"
                        Click="GoToPerformanceButton_Click"
                        Style="{StaticResource AccentButtonStyle}"/>
                <Button x:Uid="ExplorerButton_HomePage"
                        Click="GoToExplorerButton_Click"
                        Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>