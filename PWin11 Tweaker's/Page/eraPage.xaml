<Page
    x:Class="PWin11_Tweaker_s.eraPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PWin11_Tweaker_s"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:local1="using:PWin11_Tweaker_s.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <local:RoleToBackgroundConverter x:Key="RoleToBackgroundConverter"/>
        <local:DateTimeToTimeConverter x:Key="DateTimeToTimeConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: Сессии -->
        <Border Grid.Column="0"
        Background="{ThemeResource SystemControlAcrylicElementBrush}"
        CornerRadius="24"
        Margin="10"
        Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="10" HorizontalAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <Image Source="ms-appx:///Assets/full_eraAI.png"
                           Width="160"
                           Height="103"
                           VerticalAlignment="Center"/>
                            <TextBlock Text="powered by: Ollama"
                               FontSize="12"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,10"/>
                        </StackPanel>

                        <TextBlock Text="Сессии чата"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,10,0,5"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListView x:Name="SessionsListView"
                          SelectionChanged="SessionsListView_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local1:ChatSession">
                                    <Border Background="{ThemeResource ListViewItemBackground}"
                                    CornerRadius="6"
                                    Padding="8"
                                    Margin="0,2">
                                        <TextBlock Text="{x:Bind Title}"
                                           TextWrapping="Wrap"
                                           FontSize="14"/>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>
                </Grid>

                <Button x:Name="NewSessionButton"
                Click="NewSessionButton_Click"
                HorizontalAlignment="Right"
                Margin="10,10,10,20"
                Width="48"
                Height="48"
                CornerRadius="24"
                Grid.Row="1"
                Style="{StaticResource AccentButtonStyle}">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;"/>
                </Button>
            </Grid>
        </Border>

        <!-- Основная область -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="eraAI Чат"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button x:Name="ChangeModelButton"
                        Click="ChangeModelButton_Click"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Visibility="Collapsed"
                        Width="48"
                        Height="48"
                        CornerRadius="24"
                        Style="{StaticResource AccentButtonStyle}">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;"/>
                </Button>

                <Button x:Name="InstallOllamaButton"
                        Click="InstallOllamaButton_Click"
                        Grid.Column="2"
                        Visibility="Collapsed"
                        Width="48"
                        Height="48"
                        CornerRadius="24"
                        Style="{StaticResource AccentButtonStyle}">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE896;"/>
                </Button>
            </Grid>

            <!-- Область чата или панель установки -->
            <ScrollViewer x:Name="chatScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Visible">
                <StackPanel x:Name="ChatPanel" Spacing="10">
                    <ListView x:Name="ChatListView"
                              ScrollViewer.VerticalScrollMode="Enabled"
                              IsItemClickEnabled="False"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local1:Message">
                                <StackPanel Margin="5,8">
                                    <Border CornerRadius="10"
                                            Padding="10"
                                            Background="{x:Bind Role, Converter={StaticResource RoleToBackgroundConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Role}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="Gray"
                                                       Margin="0,0,0,5"/>
                                            <TextBlock Text="{x:Bind Content}"
                                                       TextWrapping="Wrap"
                                                       FontSize="14"
                                                       Foreground="White"/>
                                            <TextBlock Text="{x:Bind Timestamp, Converter={StaticResource DateTimeToTimeConverter}}"
                                                       FontSize="10"
                                                       Foreground="LightGray"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="TypingIndicator"
                               Text="ИИ печатает..."
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"
                               FontStyle="Italic"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Панель выбора и установки модели -->
            <StackPanel x:Name="InstallPanel"
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="20"
                        Visibility="Collapsed">
                <TextBlock Text="Выберите модель ИИ для установки"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                <ComboBox x:Name="ModelSelector"
                          HorizontalAlignment="Stretch"
                          Width="300">
                    <x:String>gemma3:1b (~1.4 GB)</x:String>
                    <x:String>phi3 (~2.3 GB)</x:String>
                </ComboBox>
                <Button x:Name="InstallModelButton"
                        Click="InstallModelButton_Click"
                        HorizontalAlignment="Stretch"
                        Width="48"
                        Height="48"
                        CornerRadius="24"
                        Style="{StaticResource AccentButtonStyle}">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE896;"/>
                </Button>
            </StackPanel>

            <!-- Поле ввода -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="400"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PromptTextBox"
                         PlaceholderText="Введите ваш вопрос по Windows твикам..."
                         Grid.Column="0"
                         AcceptsReturn="True"
                         KeyDown="PromptTextBox_KeyDown"/>
                <Button x:Name="SendButton"
                        Click="SendButton_Click"
                        Grid.Column="1"
                        Width="48"
                        Height="48"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE724;"/>
                </Button>
            </Grid>
        </Grid>

        <!-- Нижний статус -->
        <TextBlock x:Name="StatusTextBlock"
                   Grid.ColumnSpan="2"
                   Text="Готов к работе. Проверьте Ollama."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Foreground="Gray"
                   Margin="0,0,0,10"/>
    </Grid>
</Page>