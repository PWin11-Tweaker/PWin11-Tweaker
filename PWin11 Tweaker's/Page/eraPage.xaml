<Page
    x:Class="PWin11_Tweaker_s.eraPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PWin11_Tweaker_s"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="20" Spacing="10">
            <!-- Иконка (как раньше) -->
            <Image Source="ms-appx:///Assets/mini_eraAI.png" 
                   Width="80" 
                   Height="80" 
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

            <!-- Выбор сессии -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ComboBox x:Name="SessionComboBox" 
                          Header="Сессия чата"
                          SelectionChanged="SessionComboBox_SelectionChanged"
                          Width="300">
                </ComboBox>
                <Button x:Name="NewSessionButton" 
                        Content="Новая сессия" 
                        Click="NewSessionButton_Click"/>
            </StackPanel>

            <!-- Промпт и кнопка отправки -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBox x:Name="PromptTextBox" 
                         Header="Ваш вопрос (например, 'Как отключить UAC?')"
                         PlaceholderText="Введите промпт..."
                         Width="400"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"/>
                <Button x:Name="SendButton" 
                        Content="Отправить" 
                        Click="SendButton_Click"
                        IsEnabled="False"/>
            </StackPanel>

            <!-- История чата -->
            <ListView x:Name="ChatListView" 
                      Height="400"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:Message">
                        <StackPanel Margin="5">
                            <TextBlock Text="{x:Bind Role}" 
                                       FontWeight="Bold" 
                                       Foreground="{x:Bind Role, Converter={StaticResource RoleToColorConverter}}"/>
                            <TextBlock Text="{x:Bind Content}" 
                                       TextWrapping="Wrap" 
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{x:Bind Timestamp, Converter={StaticResource DateTimeToStringConverter}}" 
                                       FontSize="10" 
                                       Foreground="Gray"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Статус -->
            <TextBlock x:Name="StatusTextBlock" 
                       Text="Готов к работе. Проверьте Ollama." 
                       HorizontalAlignment="Center" 
                       Foreground="Gray"/>

            <!-- Нижняя панель с кнопкой установки (как на скриншоте: слева навигация, справа установка) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Spacing="10" Margin="0,20,0,0">
                <!-- Левая часть: Навигация/кнопки страниц (пустая, заполни по нужде) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BackButton" Content="← Назад" Click="BackButton_Click"/>
                    <!-- Пример навигации -->
                </StackPanel>

                <!-- Правая часть: Кнопка установки (видна только если не готово) -->
                <Button x:Name="InstallOllamaButton" 
                        Content="Установить Ollama (~100 MB) + модель (~2.3 GB)" 
                        Click="InstallOllamaButton_Click"
                        HorizontalAlignment="Right"
                        Visibility="Collapsed"/>
                <!-- Скрыта по умолчанию -->
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>