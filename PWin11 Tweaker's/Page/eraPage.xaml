<Page
    x:Class="PWin11_Tweaker_s.eraPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PWin11_Tweaker_s"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:local1="using:PWin11_Tweaker_s.Models"
    xmlns:local2="using:PWin11_Tweaker_s.Services"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <local:RoleToBackgroundConverter x:Key="RoleToBackgroundConverter"/>
        <local:DateTimeToTimeConverter x:Key="DateTimeToTimeConverter"/>
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SystemAccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{ThemeResource SystemAccentColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <!-- Новая панель для кнопок слева -->
            <ColumnDefinition x:Name="SessionsColumn" Width="260"/>
            <ColumnDefinition Width="*"/>
            <!-- Основная панель с сообщениями, уменьшена -->
        </Grid.ColumnDefinitions>

        <!-- Панель для кнопок слева -->
        <Border Grid.Column="0"
                Background="{ThemeResource SystemControlAcrylicElementBrush}"
                CornerRadius="24"
                Margin="0,10,10,10"
                Padding="10">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/mini_eraAI.png"
                           Width="40"
                           Height="40"
                           VerticalAlignment="Center"/>
                    <TextBlock Text="EraAI"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                        <TextBlock Text="Сессии чата"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,5"
                                   Foreground="{ThemeResource TextFillColorPrimary}"/>

                <ListView x:Name="SessionsListView"
                          Height="400"
                          SelectionChanged="SessionsListView_SelectionChanged"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local1:ChatSession">
                            <Border Background="{ThemeResource ListViewItemBackground}"
                                    CornerRadius="6"
                                    Padding="8"
                                    Margin="0,2">
                                <TextBlock Text="{x:Bind Title}"
                                           TextWrapping="Wrap"
                                           FontSize="14"/>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button x:Name="NewSessionButton"
                        Content="Новая сессия"
                        Click="NewSessionButton_Click"
                        HorizontalAlignment="Stretch"
                        Margin="0,10,0,0"
                        Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="2" Margin="20,10,10,10">
            <!-- Смещение вправо и уменьшение ширины через Margin -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="EraAI Чат"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button x:Name="ChangeModelButton"
                        Content="Сменить модель"
                        Click="ChangeModelButton_Click"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Visibility="Collapsed"
                        Style="{StaticResource AccentButtonStyle}"/>

                <Button x:Name="InstallOllamaButton"
                        Content="Установить Ollama (~100 MB)"
                        Click="InstallOllamaButton_Click"
                        Grid.Column="2"
                        Visibility="Collapsed"
                        Style="{StaticResource AccentButtonStyle}"/>
            </Grid>

            <!-- Область чата или панель установки -->
            <ScrollViewer x:Name="chatScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Visible">
                <StackPanel x:Name="ChatPanel" Spacing="10">
                    <ListView x:Name="ChatListView"
                              ScrollViewer.VerticalScrollMode="Enabled"
                              IsItemClickEnabled="False"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local1:Message">
                                <StackPanel Margin="5,8">
                                    <Border CornerRadius="10"
                                            Padding="10"
                                            Background="{x:Bind Role, Converter={StaticResource RoleToBackgroundConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Role}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"
                                                       Margin="0,0,0,5"/>
                                            <TextBlock x:Name="MessageContent" Text="{x:Bind Content}"
                                                       TextWrapping="Wrap"
                                                       FontSize="14"
                                                       Foreground="White"
                                                       MaxWidth="800"/>
                                            <TextBlock Text="{x:Bind Timestamp, Converter={StaticResource DateTimeToTimeConverter}}"
                                                       FontSize="10"
                                                       Foreground="White"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="TypingIndicator"
                               Text="ИИ печатает..."
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"
                               FontStyle="Italic"
                               Margin="0,10,0,0"/>
                               Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
            <!-- Панель выбора и установки модели -->
            <StackPanel x:Name="InstallPanel"
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="20"
                        Visibility="Collapsed">
                <TextBlock Text="Выберите модель ИИ для установки"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                <ComboBox x:Name="ModelSelector"
                          HorizontalAlignment="Stretch"
                          Width="300">
                    <x:String>gemma3:1b (~1.4 GB)</x:String>
                    <x:String>phi3 (~2.3 GB)</x:String>
                </ComboBox>
                <Button x:Name="InstallModelButton"
                        Content="Установить выбранную модель"
                        Click="InstallModelButton_Click"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>

            <!-- Поле ввода -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="400"/>
                    <!-- Широкое поле ввода с мин. шириной для легкой настройки -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                <TextBox x:Name="PromptTextBox"
                         PlaceholderText="Введите ваш вопрос по Windows твикам..."
                         Grid.Column="0"
                         KeyDown="PromptTextBox_KeyDown"/>

                <Button x:Name="SendButton"
                        Content="Отправить"
                        Click="SendButton_Click"
                        Grid.Column="1"
                        Width="120"
                        Height="80"
                        VerticalAlignment="Center"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}"/>
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Column="1"
                   Text="Готов к работе. Проверьте Ollama."
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Foreground="{ThemeResource SystemAccentColor}"
                   Margin="10,0,0,10"/>

        <TextBlock x:Name="PoweredByText"
                   Grid.Column="2"
                   Text="Powered by: Ollama"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Foreground="{ThemeResource TextFillColorSecondary}"
                   Margin="0,0,10,10"/>

        <TextBlock x:Name="TypingIndicator"
                   Text="ИИ печатает..."
                   Foreground="{ThemeResource SystemAccentColor}"
                   HorizontalAlignment="Center"
                   Visibility="Collapsed"
                   FontStyle="Italic"
                   Margin="0,10,0,0"/>
    </Grid>
</Page>