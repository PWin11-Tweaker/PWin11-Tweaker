<Page
    x:Class="PWin11_Tweaker_s.eraPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PWin11_Tweaker_s"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local1="using:PWin11_Tweaker_s.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <local:RoleToBackgroundConverter x:Key="RoleToBackgroundConverter"/>
        <local:DateTimeToTimeConverter x:Key="DateTimeToTimeConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left panel: Sessions -->
        <Border Grid.Column="0"
                Background="{ThemeResource SystemControlAcrylicElementBrush}"
                Opacity="0.6"
                CornerRadius="24"
                Margin="10"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="10" HorizontalAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <Image Source="ms-appx:///Assets/full_eraAI.png"
                                   Width="160"
                                   Height="103"
                                   VerticalAlignment="Center"/>
                            <TextBlock Text="powered by: Ollama"
                                       FontSize="12"
                                       Foreground="Gray"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,10"/>
                        </StackPanel>

                        <TextBlock Text="Chat Sessions"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,5"/>
                    </StackPanel>

                    <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListView x:Name="SessionsListView"
                                  SelectionChanged="SessionsListView_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local1:ChatSession">
                                    <Border Background="{ThemeResource ListViewItemBackground}"
                                            CornerRadius="6"
                                            Padding="8"
                                            Margin="0,2">
                                        <TextBlock Text="{x:Bind Title}"
                                                   TextWrapping="Wrap"
                                                   FontSize="14"/>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollView>
                </Grid>

                <Button x:Name="NewSessionButton"
                        Click="NewSessionButton_Click"
                        HorizontalAlignment="Right"
                        Margin="10,10,10,20"
                        Width="48"
                        Height="48"
                        CornerRadius="24"
                        Grid.Row="1"
                        Style="{StaticResource AccentButtonStyle}">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;"/>
                </Button>
            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top panel -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="eraAI Chat"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button x:Name="ChangeModelButton"
                        Click="ChangeModelButton_Click"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Visibility="Collapsed"
                        Width="48"
                        Height="48"
                        CornerRadius="24"
                        Style="{StaticResource AccentButtonStyle}">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;"/>
                </Button>
            </Grid>

            <!-- Chat area or installation panel -->
            <ScrollViewer x:Name="chatScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Visible">
                <StackPanel x:Name="ChatPanel" Spacing="10">
                    <ListView x:Name="ChatListView"
                              ScrollViewer.VerticalScrollMode="Enabled"
                              IsItemClickEnabled="False"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local1:Message">
                                <StackPanel Margin="5,8">
                                    <Border CornerRadius="10"
                                            Padding="10"
                                            Background="{x:Bind Role, Converter={StaticResource RoleToBackgroundConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Role}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="Gray"
                                                       Margin="0,0,0,5"/>
                                            <TextBlock Text="{x:Bind Content}"
                                                       TextWrapping="Wrap"
                                                       FontSize="14"
                                                       Foreground="White"/>
                                            <TextBlock Text="{x:Bind Timestamp, Converter={StaticResource DateTimeToTimeConverter}}"
                                                       FontSize="10"
                                                       Foreground="LightGray"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="TypingIndicator"
                               Text="The AI is typing..."
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"
                               FontStyle="Italic"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Model selection and installation panel / Ollama -->
            <StackPanel x:Name="InstallPanel"
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="20"
                        Visibility="Collapsed">
                <TextBlock x:Name="InstallTitleTextBlock" Text="Download Ollama to get started"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                <ProgressBar x:Name="InstallProgressBar"
                             Width="300"
                             Height="20"
                             Minimum="0"
                             Maximum="100"
                             Visibility="Collapsed"/>
                <Button x:Name="InstallOllamaPanelButton"
                        Click="InstallOllamaPanelButton_Click"
                        HorizontalAlignment="Stretch"
                        Width="300"
                        Height="48"
                        CornerRadius="24"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE896;" Margin="0,0,10,0"/>
                        <TextBlock Text="Download Ollama (international servers)" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="InstallRussianOllamaPanelButton"
                        Click="InstallRussianOllamaPanelButton_Click"
                        HorizontalAlignment="Stretch"
                        Width="300"
                        Height="48"
                        CornerRadius="24"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Download Ollama (Russian servers)" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="LaunchOllamaButton"
                        Click="LaunchOllamaButton_Click"
                        HorizontalAlignment="Stretch"
                        Width="300"
                        Height="48"
                        CornerRadius="24"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE756;" Margin="0,0,10,0"/>
                        <TextBlock Text="Run the installer" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="InstallOllamaStatusText" Text="Downloading fast version from GitHub (~1 GB)..."
                           FontSize="14"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed"/>
                <TextBlock Text="Select the AI model to install"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Visibility="Collapsed"/>
                <ComboBox x:Name="ModelSelector"
                          HorizontalAlignment="Stretch"
                          Width="300"
                          Visibility="Collapsed">
                    <x:String>gemma3:1b (~1.4 GB)</x:String>
                    <x:String>phi3 (~2.3 GB)</x:String>
                </ComboBox>
                <Button x:Name="InstallModelButton"
                        Click="InstallModelButton_Click"
                        HorizontalAlignment="Stretch"
                        Width="48"
                        Height="48"
                        CornerRadius="24"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="Collapsed">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE896;"/>
                </Button>
            </StackPanel>

            <!-- Input field -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="400"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PromptTextBox"
                         PlaceholderText="Enter your question about Windows tweaks..."
                         Grid.Column="0"
                         AcceptsReturn="True"
                         KeyDown="PromptTextBox_KeyDown"/>
                <Button x:Name="SendButton"
                        Click="SendButton_Click"
                        Grid.Column="1"
                        Width="48"
                        Height="48"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE724;"/>
                </Button>
            </Grid>
        </Grid>

        <!-- Bottom status -->
        <TextBlock x:Name="StatusTextBlock"
                   Grid.ColumnSpan="2"
                   Text="Ready to work. Check Ollama."
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Foreground="Gray"
                   Margin="0,0,0,10"/>
    </Grid>
</Page>