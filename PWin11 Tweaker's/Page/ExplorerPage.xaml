<Page
    x:Class="PWin11_Tweaker_s.ExplorerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PWin11_Tweaker_s"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Spacing="15">
            <TextBlock x:Uid="Text_Settings" FontSize="24" FontWeight="SemiBold"/>

            <!-- Показ скрытых файлов -->
            <CheckBox x:Name="ShowHiddenFiles" x:Uid="ShowHiddenFiles">
                <ToolTipService.ToolTip>
                    <ToolTip x:Uid="Coment_ShowHiddenFiles"/>
                </ToolTipService.ToolTip>
            </CheckBox>

            <!-- Уменьшение кнопок -->
            <CheckBox x:Name="UseSmallCaptions" x:Uid="UseSmallCaptions">
                <ToolTipService.ToolTip>
                    <ToolTip x:Uid="Coment_UseSmallCaptions"/>
                </ToolTipService.ToolTip>
            </CheckBox>

            <!-- Классическое контекстное меню -->
            <CheckBox x:Name="ClassicContextMenuToggle" x:Uid="ClassicContextMenu">
                <ToolTipService.ToolTip>
                    <ToolTip x:Uid="Coment_ClassicContextMenu"/>
                </ToolTipService.ToolTip>
            </CheckBox>

            <!-- Установка/удаление StartAllBack -->
            <Button x:Name="InstallStartAllBackButton" x:Uid="Content_Button_StartAllBack" Click="InstallStartAllBackButton_Click" Style="{StaticResource AccentButtonStyle}"/>

            <!-- Кнопка открытия OldNewExplorer -->
            <Button x:Name="OpenOldNewExplorerButton" x:Uid="OpenOldNewExplorer" Click="OpenOldNewExplorerButton_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,10,0,0"/>

            <!-- Кнопка применения -->
            <Button x:Name="ApplyButton" x:Uid="Apply" Click="ApplyButton_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,10,0,0"/>

            <!-- Прогресс и статус -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Spacing="5">
                <TextBlock x:Name="StatusText" Text="Выполняется..."/>
                <ProgressBar x:Name="ProgressBar" IsIndeterminate="False" Minimum="0" Maximum="100" Value="0" 
                             Foreground="{ThemeResource SystemAccentColor}" Background="{ThemeResource SubtleFillColorSecondary}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>