<Page
    x:Class="PWin11_Tweaker_s.SystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Заголовок -->
            <TextBlock x:Uid="System_Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>

            <!-- Оптимизация служб -->
            <TextBlock x:Uid="Optimization" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <CheckBox x:Name="DisableServicesCheckBox" x:Uid="DisableServices" Margin="0,5,0,5">
                <ToolTipService.ToolTip>
                    <ToolTip x:Uid="DisableServicesComment"/>
                </ToolTipService.ToolTip>
            </CheckBox>

            <!-- Безопасность -->
            <TextBlock x:Uid="Secure" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <CheckBox x:Name="DisableUACCheckBox" x:Uid="DisableUAC" Margin="0,5,0,5">
                <ToolTipService.ToolTip>
                    <ToolTip x:Uid="DisableUACComment"/>
                </ToolTipService.ToolTip>
            </CheckBox>

            <!-- Конфиденциальность -->
            <TextBlock x:Uid="PrivacyTitle" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <CheckBox x:Name="DisableClipboardCheckBox" x:Uid="DisableClipboardHistory" Margin="0,5,0,5">
                <ToolTipService.ToolTip>
                    <ToolTip x:Uid="DisableClipboardHistoryComment"/>
                </ToolTipService.ToolTip>
            </CheckBox>

            <!-- Производительность -->
            <TextBlock x:Uid="PerformanceTitle" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <CheckBox x:Name="SpeedUpWindowsCheckBox" x:Uid="SpeedUPWin" Margin="0,5,0,5">
                <ToolTipService.ToolTip>
                    <ToolTip x:Uid="SpeedUPWinComment"/>
                </ToolTipService.ToolTip>
            </CheckBox>

            <!-- Кнопка применения -->
            <Button x:Name="ApplyButton" x:Uid="Apply" Click="ApplyButton_Click" Margin="0,10,0,0"/>

            <!-- Статус -->
            <TextBlock x:Name="StatusText" x:Uid="Status" FontSize="14" Margin="0,10,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</Page>