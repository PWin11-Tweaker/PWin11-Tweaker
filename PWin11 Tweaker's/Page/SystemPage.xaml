<Page
    x:Class="PWin11_Tweaker_s.SystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:WinUI3Localizer"
    Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Заголовок -->
            <TextBlock l:Uids.Uid="System_Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>

            <!-- Оптимизация служб -->
            <TextBlock l:Uids.Uid="Optimization" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <CheckBox x:Name="DisableServicesCheckBox" l:Uids.Uid="DisableServices" Margin="0,5,0,5">
                <ToolTipService.ToolTip>
                    <ToolTip l:Uids.Uid="DisableServicesComment"/>
                </ToolTipService.ToolTip>
            </CheckBox>

            <!-- Безопасность -->
            <TextBlock l:Uids.Uid="Secure" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <CheckBox x:Name="DisableUACCheckBox" l:Uids.Uid="DisableUAC" Margin="0,5,0,5">
                <ToolTipService.ToolTip>
                    <ToolTip l:Uids.Uid="DisableUACComment"/>
                </ToolTipService.ToolTip>
            </CheckBox>

            <!-- Конфиденциальность -->
            <TextBlock l:Uids.Uid="PrivacyTitle" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <CheckBox x:Name="DisableClipboardCheckBox" l:Uids.Uid="DisableClipboardHistory" Margin="0,5,0,5">
                <ToolTipService.ToolTip>
                    <ToolTip l:Uids.Uid="DisableClipboardHistoryComment"/>
                </ToolTipService.ToolTip>
            </CheckBox>

            <!-- Производительность -->
            <TextBlock l:Uids.Uid="PerformanceTitle" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <CheckBox x:Name="SpeedUpWindowsCheckBox" l:Uids.Uid="SpeedUPWin" Margin="0,5,0,5">
                <ToolTipService.ToolTip>
                    <ToolTip l:Uids.Uid="SpeedUPWinComment"/>
                </ToolTipService.ToolTip>
            </CheckBox>

            <!-- Кнопки применения и отмены -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="ApplyButton" l:Uids.Uid="Apply" Click="ApplyButton_Click" Margin="0,10,0,0"/>
                <Button x:Name="CancelButton" Content="Отменить" Click="CancelButton_Click" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- Статус -->
            <TextBlock x:Name="StatusText" l:Uids.Uid="Status" FontSize="14" Margin="0,10,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</Page>