<Page
    x:Class="PWin11_Tweaker_s.SystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer>
        <StackPanel Margin="20">
            <!-- Заголовок -->
            <TextBlock Text="Настройки системы" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>

            <!-- Оптимизация служб -->
            <TextBlock Text="Оптимизация служб" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <CheckBox x:Name="DisableServicesCheckBox" Content="Отключить ненужные службы" Margin="0,5,0,5">
                <ToolTipService.ToolTip>
                    <ToolTip Content="Отключает службы: Windows Search, Fax, Print Spooler, Remote Registry, Windows Update Medic."/>
                </ToolTipService.ToolTip>
            </CheckBox>

            <!-- Безопасность -->
            <TextBlock Text="Безопасность" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <CheckBox x:Name="DisableUACCheckBox" Content="Отключить контроль учётных записей (UAC)" Margin="0,5,0,5">
                <ToolTipService.ToolTip>
                    <ToolTip Content="Отключает запросы UAC для повышения удобства (может снизить безопасность)."/>
                </ToolTipService.ToolTip>
            </CheckBox>

            <!-- Конфиденциальность -->
            <TextBlock Text="Конфиденциальность" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <CheckBox x:Name="DisableClipboardCheckBox" Content="Отключить историю буфера обмена" Margin="0,5,0,5">
                <ToolTipService.ToolTip>
                    <ToolTip Content="Запрещает Windows сохранять историю буфера обмена."/>
                </ToolTipService.ToolTip>
            </CheckBox>

            <!-- Производительность -->
            <TextBlock Text="Производительность" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <CheckBox x:Name="SpeedUpWindowsCheckBox" Content="Ускорить работу Windows" Margin="0,5,0,5">
                <ToolTipService.ToolTip>
                    <ToolTip Content="Отключает анимации и задержку меню Пуск для ускорения системы."/>
                </ToolTipService.ToolTip>
            </CheckBox>

            <!-- Кнопка применения -->
            <Button x:Name="ApplyButton" Content="Применить" Click="ApplyButton_Click" Margin="0,10,0,0"/>

            <!-- Статус -->
            <TextBlock x:Name="StatusText" Text="" FontSize="14" Margin="0,10,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</Page>