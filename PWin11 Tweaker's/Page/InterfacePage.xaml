<Page
    x:Class="PWin11_Tweaker_s.InterfacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PWin11_Tweaker_s"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="Настройки интерфейса" FontSize="24" FontWeight="SemiBold"/>

        <!-- Выравнивание панели задач -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Выравнивание панели задач:" VerticalAlignment="Center"/>
            <ComboBox x:Name="TaskbarAlignmentCombo" SelectionChanged="TaskbarAlignmentCombo_SelectionChanged">
                <ComboBoxItem Content="По центру" Tag="1"/>
                <ComboBoxItem Content="Слева" Tag="0"/>
            </ComboBox>
        </StackPanel>

        <!-- Прозрачность панели задач -->
        <CheckBox x:Name="TaskbarTransparencyToggle" Content="Включить прозрачность панели задач"/>

        <!-- Скрытие кнопки поиска -->
        <CheckBox x:Name="HideSearchButtonToggle" Content="Скрыть кнопку поиска на панели задач"/>

        <!-- Кнопка применения -->
        <Button x:Name="ApplyButton" Content="Применить" Click="ApplyButton_Click" Margin="0,10,0,0"/>

        <!-- Прогресс и статус -->
        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Spacing="5">
            <TextBlock x:Name="StatusText" Text="Выполняется..."/>
            <ProgressBar x:Name="ProgressBar" IsIndeterminate="False" Minimum="0" Maximum="100" Value="0"/>
        </StackPanel>
    </StackPanel>
</Page>