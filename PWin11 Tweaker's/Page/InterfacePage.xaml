<Page
    x:Class="PWin11_Tweaker_s.InterfacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <StackPanel Margin="20" Spacing="10">
        <TextBlock x:Uid="SettingsInterface" FontSize="24" FontWeight="SemiBold"/>

        <!-- Выравнивание панели задач -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock x:Uid="TaskbarAlignment" VerticalAlignment="Center"/>
            <ComboBox x:Name="TaskbarAlignmentCombo" SelectionChanged="TaskbarAlignmentCombo_SelectionChanged">
                <ComboBoxItem x:Uid="Center" Tag="1"/>
                <ComboBoxItem x:Uid="LeftTaskBar" Tag="0"/>
            </ComboBox>
        </StackPanel>

        <!-- Прозрачность панели задач -->
        <CheckBox x:Name="TaskbarTransparencyToggle" x:Uid="TaskbarTransparency"/>

        <!-- Скрытие кнопки поиска -->
        <CheckBox x:Name="HideSearchButtonToggle" x:Uid="HideSearchButton"/>

        <!-- Кнопки применения и отмены -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button x:Name="ApplyButton" x:Uid="Apply" Click="ApplyButton_Click" Margin="0,10,0,0"/>
            <Button x:Name="CancelButton" Content="Отменить" Click="CancelButton_Click" Margin="0,10,0,0"/>
        </StackPanel>
    
        <!-- Прогресс и статус -->
        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Spacing="5">
            <TextBlock x:Name="StatusText" Text="Выполняется..."/>
            <ProgressBar x:Name="ProgressBar" IsIndeterminate="False" Minimum="0" Maximum="100" Value="0"/>
        </StackPanel>
    </StackPanel>
</Page>