<Window
    x:Class="PWin11_Tweaker_s.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PWin11_Tweaker_s"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:animations="using:Microsoft.UI.Xaml.Media.Animation"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TitleBar x:Name="SimpleTitleBar"
                  Title="PWin11 Tweaker"
                  Grid.Row="0">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/new_logo/mini_logo.png" />
            </TitleBar.IconSource>
        </TitleBar>
        <NavigationView x:Name="NavView"
                        PaneDisplayMode="Top"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        ItemInvoked="NavView_ItemInvoked"
                        Grid.Row="1">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Home" Tag="HomePage">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="/Assets/icons_nav2/home.png"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Explorer" Tag="ExplorerPage">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="/Assets/icons_nav2/explorer.png"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="System" Tag="SystemPage">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="/Assets/icons_nav2/system.png"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Interface" Tag="InterfacePage">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="/Assets/icons_nav2/interface.png"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Performance" Tag="PerformancePage">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="/Assets/icons_nav2/performans.png"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Privacy" Tag="PrivacyPage">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="/Assets/icons_nav2/privacy.png"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="TempCleaner" Tag="TempCleanerPage">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="/Assets/icons_nav2/trash.png"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- Новая кнопка для eraPage -->
                <NavigationViewItem Content="eraAI" Tag="eraPage">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="/Assets/icons_nav2/eraai.png"/>
                        <!-- Добавь иконку в Assets/icons_nav2/ -->
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator/>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" Margin="20">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition>
                            <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                <DrillInNavigationTransitionInfo />
                            </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                        </NavigationThemeTransition>
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>

        <TextBlock x:Name="AdminWarningText" 
                   x:Uid="AdminWarning" 
                   Foreground="WhiteSmoke" 
                   FontSize="14" 
                   TextWrapping="Wrap" 
                   Visibility="Collapsed" 
                   VerticalAlignment="Bottom" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,10"
                   Grid.Row="2"/>

        <TextBlock x:Name="UpdateWarningText" 
                   x:Uid="UpdateWarning" 
                   Text="Обнови Windows" 
                   Foreground="Red" 
                   FontSize="14" 
                   TextWrapping="Wrap" 
                   Visibility="Collapsed" 
                   VerticalAlignment="Bottom" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,40"
                   Grid.Row="2"/>
    </Grid>
</Window>