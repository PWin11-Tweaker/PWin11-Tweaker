<Window
    x:Class="PWin11_Tweaker_s.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <NavigationView x:Name="NavView"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        Header="PWin11 Tweaker's"
                        ItemInvoked="NavView_ItemInvoked">
            <NavigationView.Resources>
                <!-- Стиль для FontIcon -->
                <Style TargetType="FontIcon">
                    <Setter Property="FontSize" Value="20"/>
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimary}"/>
                </Style>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Главная" Tag="HomePage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph=""/> <!-- Home -->
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Проводник" Tag="ExplorerPage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph=""/> <!-- Folder -->
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Система" Tag="SystemPage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph=""/> <!-- System -->
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Интерфейс" Tag="InterfacePage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph=""/> <!-- Layout -->
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Производительность" Tag="PerformancePage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph=""/> <!-- Speedometer -->
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Конфиденциальность" Tag="PrivacyPage">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph=""/> <!-- Permissions -->
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator/>
                <!-- Удалён пункт "Переключить тему" -->
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" Margin="20" />
        </NavigationView>
    </Grid>
</Window>