<Window
    x:Class="PWin11_Tweaker_s.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <NavigationView x:Name="NavView"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        Header="PWin11 Tweaker's"
                        ItemInvoked="NavView_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Главная" Tag="HomePage"/>
                <NavigationViewItem Content="Проводник" Tag="ExplorerPage"/>
                <NavigationViewItem Content="Система" Tag="SystemPage"/>
                <NavigationViewItem Content="Интерфейс" Tag="InterfacePage"/>
                <NavigationViewItem Content="Производительность" Tag="PerformancePage" />
                <NavigationViewItem Content="Конфиденциальность" Tag="PrivacyPage"/>
                <NavigationViewItemSeparator/>
                <NavigationViewItem Content="Переключить тему" Tag="ToggleTheme"/>
                <NavigationViewItem Content="Параметры" Tag="SettingsPage"/>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" Margin="20" />
        </NavigationView>
    </Grid>
</Window>