<Page
    x:Class="PWin11_Tweaker_s.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PWin11_Tweaker_s"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0" 
               Source="/Assets/icon4.png" 
               Height="150" 
               Width="150" 
               Margin="0,0,20,0"
               VerticalAlignment="Top"/>

        <StackPanel Grid.Column="1" 
                    VerticalAlignment="Top"
                    Margin="0,0,0,0">

            <TextBlock x:Uid="pwin11" 
                       FontSize="24" 
                       Margin="0,0,0,10"/>

            <TextBlock x:Uid="About" 
                       TextWrapping="Wrap" 
                       FontSize="16" 
                       Margin="0,0,0,20">
            </TextBlock>

            <TextBlock x:Name="ServerVersionText" 
                       Text="Server Version: Not Checked" 
                       FontSize="14" 
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="LocalVersionText" 
                       Text="Local Version: Not Loaded" 
                       FontSize="14" 
                       Margin="0,0,0,10"/>


            <!-- Новая кнопка для проверки обновлений -->
            <Button x:Name="CheckUpdatesButton" 
                    Click="CheckUpdatesButton_Click" 
                    Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Image Source="/Assets/update.png" Width="16" Height="16"/>
                    <!-- Добавьте иконку обновления -->
                    <TextBlock Text="Check for Updates" FontSize="14"/>
                </StackPanel>
            </Button>

            <!-- Элементы для отображения прогресса (добавлены для удобства) -->
            <TextBlock x:Name="UpdateStatusText" 
                       Text="Update Status: Not Checked" 
                       Margin="0,10,0,0"/>
            <ProgressBar x:Name="UpdateProgressBar" 
                        IsIndeterminate="False" 
                        Minimum="0" 
                        Maximum="100" 
                        Value="0" 
                        Margin="0,5,0,0" 
                        Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Page>