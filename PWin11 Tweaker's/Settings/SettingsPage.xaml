<Page
    x:Class="PWin11_Tweaker_s.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PWin11_Tweaker_s"
    xmlns:l="using:WinUI3Localizer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0" 
               Source="/Assets/new_logo/logo.png" 
               Height="150" 
               Width="150" 
               Margin="0,0,20,0"
               VerticalAlignment="Top"/>

        <StackPanel Grid.Column="1" 
                    VerticalAlignment="Top"
                    Margin="0,0,0,0"
                    Spacing="10">

            <TextBlock l:Uids.Uid="pwin11" 
                       FontSize="24" 
                       Margin="0,0,0,10"/>

            <TextBlock l:Uids.Uid="AboutText_Settings"
                       TextWrapping="Wrap"
                       FontSize="16"
                       Margin="0,0,0,20"/>

            <Button x:Name="LanguageButton"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE774;"/>
                    <TextBlock x:Name="LanguageButtonText" FontSize="14"/>
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="English" Tag="en-US" Click="LanguageMenuItem_Click"/>
                        <MenuFlyoutItem Text="Русский" Tag="ru_RU" Click="LanguageMenuItem_Click"/>
                        <MenuFlyoutItem Text="Français" Tag="fr-FR" Click="LanguageMenuItem_Click"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <Button x:Name="OpenUpdaterButton"
                    Click="OpenUpdaterButton_Click" 
                    Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Image Source="/Assets/update.png" Width="16" Height="16"/>
                    <TextBlock Text="Open Updater" FontSize="14"/>
                </StackPanel>
            </Button>

            <Button x:Name="UninstallOllamaButton" 
                    Click="UninstallOllamaButton_Click"
                    Margin="0,10,0,0"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" Margin="0,0,5,0"/>
                    <TextBlock Text="" FontSize="14"/>
                </StackPanel>
            </Button>

            <TextBlock x:Name="UninstallOllamaStatusText"
                       l:Uids.Uid="status_delete_ollama"
                       FontSize="14"
                       Foreground="Gray"
                       HorizontalAlignment="Left"
                       Visibility="Collapsed"
                       Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Page>