<Window x:Class="PWin11Updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PWin11 Updater" Height="300" Width="496" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#4A90E2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                BorderThickness="1"
                                BorderBrush="#357ABD">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#357ABD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Background="#212121">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Image Grid.Row="0" Source="/img/icon4.png" Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Top" Grid.RowSpan="2" Margin="0,10,0,0"/>
        <TextBlock Grid.Row="1" x:Name="LocalVersionText" Text="Local Version: Not Loaded" HorizontalAlignment="Left" FontSize="14" Foreground="White" Margin="10,32,0,15" Grid.RowSpan="2"/>
        <TextBlock Grid.Row="1" x:Name="ServerVersionText" Text="Server Version: Not Checked" HorizontalAlignment="Left" FontSize="14" Foreground="White" Margin="311,32,0,15" Grid.RowSpan="2"/>
        <Button Grid.Row="3" x:Name="CheckUpdatesButton" Click="CheckUpdatesButton_Click" Content="Check for Updates" HorizontalAlignment="Center" Margin="0,10,0,39" Width="476"/>
        <TextBlock Grid.Row="3" x:Name="UpdateStatusText" Text="Update Status: Not Checked" HorizontalAlignment="Left" Margin="10,66,0,10" Foreground="White"/>
        <ProgressBar Grid.Row="3" x:Name="UpdateProgressBar" IsIndeterminate="False" Minimum="0" Maximum="100" Value="0" Width="200" Height="20" HorizontalAlignment="Center" Margin="0,70,0,0" Visibility="Collapsed"/>
    </Grid>
</Window>